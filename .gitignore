# Environments
detector/venv/
**/__pycache__/
*.pyc
.pytest_cache/

# Data — ASVspoof pilot slice, re-fetchable via detector/src/fetch_data.py
detector/data/

# Model caches
**/.cache/
prototype/artifacts/models/

# Generated demo audio + media (regenerate with scripts/make_demo_calls.py)
prototype/artifacts/demo/*.wav
prototype/artifacts/media/
# Synthetic-voice assets are generated (scripts/make_clone_assets.py) and can be
# large media; the manifest that labels them is kept.
prototype/artifacts/clones/*.wav
prototype/artifacts/clones/*.aiff

# Runtime logs
prototype/artifacts/evidence/*.jsonl

# Voice fingerprints are runtime state. The demo speaker's enrolment is shipped
# so the demo runs out of the box; anyone else's stays out of the repository --
# that includes the presenter's own, enrolled live while testing a dry run.
prototype/artifacts/enrolments/*
!prototype/artifacts/enrolments/LA_0022.*

# Large binaries that live outside the build
*.pptx
*.pdf
ppt-preview/

# macOS
.DS_Store
